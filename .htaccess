# Canonical URLs: HTTPS, non-www, and directory homepages.
RewriteEngine On

# Match explicit client requests only; avoid DirectoryIndex redirect loops.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ https://aipracticelab.org/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+es/index\.html(?:[?\s]) [NC]
RewriteRule ^es/index\.html$ https://aipracticelab.org/es/ [R=301,L]

# Include the trailing slash before scheme/host normalization.
RewriteRule ^es$ https://aipracticelab.org/es/ [R=301,L]

# Normalize scheme and hostname together, preserving path and query string.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.aipracticelab\.org(?::[0-9]+)?$ [NC]
RewriteRule ^ https://aipracticelab.org%{REQUEST_URI} [R=301,L]

DirectoryIndex index.html
